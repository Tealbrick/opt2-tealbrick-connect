{
  "title": "tb.access/1 access_list output",
  "description": "Spec 0.1.89, docs/ACCESS.md. Embedded byte for byte as the op output (M-OP-8: no $id). Dialect: JSON Schema 2020-12. Extra members are allowed and ignored (L24). complete is true exactly when nextCursor is null and notShown is empty.",
  "type": "object",
  "required": [
    "v",
    "asOf",
    "items",
    "nextCursor",
    "notShown",
    "complete"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "asOf": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sweepId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "nextCursor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "notShown": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "reason"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "complete": {
      "type": "boolean"
    }
  },
  "if": {
    "required": [
      "complete"
    ],
    "properties": {
      "complete": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "nextCursor": {
        "type": "null"
      },
      "notShown": {
        "maxItems": 0
      }
    }
  },
  "else": {
    "anyOf": [
      {
        "properties": {
          "nextCursor": {
            "type": "string"
          }
        }
      },
      {
        "properties": {
          "notShown": {
            "minItems": 1
          }
        }
      }
    ]
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "subject",
        "resource",
        "direction",
        "level",
        "label",
        "state",
        "revocable",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z_]*:[!-~]+$",
          "description": "Stable, <kind>:<opaque>, ASCII without spaces."
        },
        "kind": {
          "enum": [
            "account_as_itself",
            "account_as_me",
            "buzz_identity",
            "scheduled_post",
            "first_contacts",
            "channel_sender",
            "agent_area",
            "person_area",
            "team_grant",
            "assignment",
            "own_project",
            "routine",
            "workflow_agent_step",
            "schedule_of_workflow"
          ],
          "description": "Closed list per target: ACCESS_KINDS in the spec package."
        },
        "subject": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "const": "agent"
                },
                "id": {
                  "type": "string",
                  "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "const": "person"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "unlinked"
                }
              }
            }
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "direction": {
          "enum": [
            "held_by",
            "about"
          ]
        },
        "level": {
          "enum": [
            "read",
            "write",
            "use",
            "info"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "enum": [
            "active",
            "paused",
            "scheduled",
            "dormant"
          ]
        },
        "revocable": {
          "type": "boolean"
        },
        "since": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
