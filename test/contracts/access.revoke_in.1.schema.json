{
  "title": "tb.access/1 access_revoke input",
  "description": "Spec 0.1.89, docs/ACCESS.md. Embedded byte for byte as the op input (M-OP-8: no $id). Dialect: JSON Schema 2020-12. No free text. Connect refuses more than 5 items (ACCESS_REVOKE_ITEMS_MAX).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "plan",
    "attempt",
    "subject",
    "items"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "plan": {
      "type": "string",
      "pattern": "^pln_[0-9A-Za-z]{1,40}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "agent"
            },
            "id": {
              "type": "string",
              "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "person"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z_]*:[!-~]+$",
            "description": "Stable, <kind>:<opaque>, ASCII without spaces."
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
