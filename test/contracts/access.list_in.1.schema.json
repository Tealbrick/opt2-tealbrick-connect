{
  "title": "tb.access/1 access_list input",
  "description": "Spec 0.1.89, docs/ACCESS.md. Embedded byte for byte as the op input (M-OP-8: no $id). Dialect: JSON Schema 2020-12.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "subjects"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/subject"
      },
      "if": {
        "contains": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "all"
            }
          }
        }
      },
      "then": {
        "maxItems": 1
      },
      "description": "Kind all must be the only subject."
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 100
    },
    "sweepId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Echoed in the answer."
    }
  },
  "$defs": {
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "agent"
            },
            "id": {
              "type": "string",
              "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "handles"
          ],
          "properties": {
            "kind": {
              "const": "person"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "handles": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(buzz:npub1[qpzry9x8gf2tvdw0s3jn54khce6mua7l]{58}|slack:[UW][A-Z0-9]{2,30}|telegram:-?[1-9][0-9]{0,19})$",
                "description": "Canonical handle (G-4), the fleet.directory_feed/1 pattern. Readers also require normalizeHandle(h) === h."
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unlinked"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "all"
            }
          }
        }
      ]
    }
  }
}
