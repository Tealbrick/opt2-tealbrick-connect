{
  "name": "@opt2-tealbrick/connect",
  "version": "0.6.0",
  "private": true,
  "description": "Teal Brick Connect miniapp: Composio, MCP connectors, Tealbrick catalog, Channels. Built on the Miniapp SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && check-system src",
    "test": "node --test 'test/**/*.test.ts'",
    "conformance": "tb-conformance app --start conformance.start.ts --manifest tealbrick.manifest.json --inputs conformance.inputs.json && node scripts/conformance.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-ui.ts",
    "gen": "tb-gen all",
    "catalog:build": "node scripts/catalog-build.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@opt2-tealbrick/manifest": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-sdk-manifest-v0.1.26/opt2-tealbrick-manifest-0.1.26.tgz",
    "@opt2-tealbrick/miniapp-sdk": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-sdk-miniapp-sdk-v0.1.34/opt2-tealbrick-miniapp-sdk-0.1.34.tgz",
    "@opt2-tealbrick/spec": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-specs-spec-v0.1.49/opt2-tealbrick-spec-0.1.49.tgz",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opt2-tealbrick/conformance": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-sdk-conformance-v0.1.23/opt2-tealbrick-conformance-0.1.23.tgz",
    "@opt2-tealbrick/ui": "https://github.com/Tealbrick/opt2-tealbrick-dist/releases/download/opt2-tealbrick-packages-ui-v0.2.4/opt2-tealbrick-ui-0.2.4.tgz",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "happy-dom": "21.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
